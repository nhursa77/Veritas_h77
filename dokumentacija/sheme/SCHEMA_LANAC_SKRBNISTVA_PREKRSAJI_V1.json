{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCHEMA_LANAC_SKRBNISTVA_PREKRSAJI_V1",
  "type": "object",
  "required": [
    "meta",
    "manifest",
    "dogadaji",
    "zavrsni_dogadaj_sha256"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "standard_id",
        "id_predmeta",
        "tok",
        "verzija_toka",
        "datum_vrijeme_izrade",
        "algoritam_sazetka",
        "status"
      ],
      "properties": {
        "standard_id": {
          "type": "string",
          "enum": ["LANAC_SKRBNISTVA_PREKRSAJI_V1"]
        },
        "id_predmeta": { "type": "string" },
        "tok": {
          "type": "string",
          "enum": ["TOK_PN_PRIGOVOR"]
        },
        "verzija_toka": {
          "type": "string",
          "enum": ["v1"]
        },
        "datum_vrijeme_izrade": {
          "type": "string",
          "pattern": "^[0-9]{2}[.][0-9]{2}[.][0-9]{4}[.] [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{2}:[0-9]{2}$"
        },
        "algoritam_sazetka": {
          "type": "string",
          "enum": ["SHA-256"]
        },
        "status": {
          "type": "string",
          "enum": ["P8_PROLAZ"]
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "putanja",
        "sha256",
        "broj_artefakata",
        "korijenski_sha256"
      ],
      "properties": {
        "putanja": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/.+/manifest[.]json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "broj_artefakata": { "type": "integer" },
        "korijenski_sha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    },
    "dogadaji": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "redni_broj",
          "id",
          "datum_vrijeme",
          "izvrsitelj",
          "radnja",
          "detalj",
          "dokaz_sha256",
          "prethodni_dogadaj_sha256",
          "dogadaj_sha256"
        ],
        "properties": {
          "redni_broj": { "type": "integer" },
          "id": {
            "type": "string",
            "pattern": "^P8-[0-9]{3}$"
          },
          "datum_vrijeme": {
            "type": "string",
            "pattern": "^[0-9]{2}[.][0-9]{2}[.][0-9]{4}[.] [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{2}:[0-9]{2}$"
          },
          "izvrsitelj": {
            "type": "string",
            "enum": ["veritas_h77"]
          },
          "radnja": {
            "type": "string",
            "enum": ["ULAZI_PROVJERENI", "MANIFEST_ZAPISAN"]
          },
          "detalj": { "type": "string" },
          "dokaz_sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "prethodni_dogadaj_sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "dogadaj_sha256": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          }
        }
      }
    },
    "zavrsni_dogadaj_sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}


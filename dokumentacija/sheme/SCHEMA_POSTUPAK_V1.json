{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCHEMA_POSTUPAK_V1",
  "type": "object",
  "required": [
    "meta",
    "ulazi",
    "koraci",
    "izlazi"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "naziv",
        "domena",
        "datum_izrade",
        "verzija"
      ],
      "properties": {
        "id": { "type": "string" },
        "naziv": { "type": "string" },
        "domena": { "type": "string" },
        "datum_izrade": { "type": "string" },
        "verzija": { "type": "string" }
      }
    },
    "ulazi": { "type": "object" },
    "koraci": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "naziv",
          "opis",
          "ulazi",
          "izlazi",
          "gate"
        ],
        "properties": {
          "id": { "type": "string" },
          "naziv": { "type": "string" },
          "opis": { "type": "string" },
          "ulazi": { "type": "array" },
          "izlazi": { "type": "array" },
          "gate": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "izvor_ref",
                "putanja",
                "operator",
                "vrijednost",
                "akcija_na_fail"
              ],
              "properties": {
                "izvor_ref": { "type": "string" },
                "putanja": { "type": "string" },
                "operator": {
                  "type": "string",
                  "enum": ["=="]
                },
                "vrijednost": {},
                "akcija_na_fail": {
                  "type": "string",
                  "enum": ["STOP_BEZ_IZLAZA"]
                }
              }
            }
          }
        }
      }
    },
    "izlazi": { "type": "object" }
  }
}
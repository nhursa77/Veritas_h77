{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCHEMA_POSTUPAK_V1",
  "type": "object",
  "required": [
    "meta",
    "ulazi",
    "koraci",
    "izlazi"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "naziv",
        "domena",
        "datum_izrade",
        "verzija"
      ],
      "properties": {
        "id": { "type": "string" },
        "naziv": { "type": "string" },
        "domena": { "type": "string" },
        "datum_izrade": { "type": "string" },
        "verzija": { "type": "string" }
      }
    },
    "ulazi": {
      "type": "object",
      "required": [
        "predmet_ref",
        "dokazi_dir_ref",
        "audit_ref",
        "subsumcija_ref",
        "intake_ref",
        "predlozak_ref",
        "norma_refs"
      ],
      "properties": {
        "predmet_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/predmet[.]json$"
        },
        "dokazi_dir_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/dokazi/$"
        },
        "audit_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/audit/audit_generated_v1[.]json$"
        },
        "subsumcija_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/audit/subsumcija_v1[.]json$"
        },
        "intake_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/intake/intake_v1[.]json$"
        },
        "predlozak_ref": {
          "type": "string",
          "pattern": "^predlosci/sud/prekrsajni/.+/v1/predlozak[.]json$"
        },
        "norma_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^baza_zakona/norme/.+[.]json$"
          }
        }
      }
    },
    "koraci": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "naziv",
          "opis",
          "ulazi",
          "izlazi",
          "gate"
        ],
        "properties": {
          "id": { "type": "string" },
          "naziv": { "type": "string" },
          "opis": { "type": "string" },
          "ulazi": { "type": "array" },
          "izlazi": { "type": "array" },
          "gate": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "izvor_ref",
                "putanja",
                "operator",
                "vrijednost",
                "akcija_na_fail"
              ],
              "properties": {
                "izvor_ref": { "type": "string" },
                "putanja": { "type": "string" },
                "operator": {
                  "type": "string",
                  "enum": ["=="]
                },
                "vrijednost": {},
                "akcija_na_fail": {
                  "type": "string",
                  "enum": ["STOP_BEZ_IZLAZA"]
                }
              }
            }
          }
        }
      }
    },
    "izlazi": {
      "type": "object",
      "required": ["nacrt_ref"],
      "properties": {
        "nacrt_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/izlazi/nacrt_.+_v1[.]txt$"
        },
        "manifest_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/manifest[.]json$"
        },
        "lanac_skrbnistva_ref": {
          "type": "string",
          "pattern": "^predmeti/sud/prekrsajni/\\{PREDMET_ID\\}/lanac_skrbnistva[.]json$"
        }
      }
    }
  }
}

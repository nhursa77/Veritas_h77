{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritas-h77.local/sheme/registar_ai_normi_v1.schema.json",
  "title": "Registar AI normi Veritas H.77 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_id",
    "verzija",
    "status",
    "datum_provjere",
    "norme"
  ],
  "properties": {
    "standard_id": {
      "const": "VERITAS_H77_AI_NORME_V1"
    },
    "verzija": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-a[0-9]+$"
    },
    "status": {
      "const": "RADNI_NACRT"
    },
    "datum_provjere": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])\\.(0[1-9]|1[0-2])\\.[0-9]{4}\\.$"
    },
    "norme": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/norma"
      }
    }
  },
  "$defs": {
    "referenca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "putanja",
        "sidro"
      ],
      "properties": {
        "putanja": {
          "type": "string",
          "minLength": 1
        },
        "sidro": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "norma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "naziv",
        "podrucje",
        "snaga",
        "primjenjivost",
        "zivotni_ciklus",
        "migracija",
        "kanonski_izvori",
        "uvjet_aktiviranja",
        "zahtijeva_ljudsku_odluku",
        "provedba",
        "testovi",
        "ci_koraci",
        "razina_dokaza",
        "ocjena",
        "otvorene_praznine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{3}-[0-9]{3}$"
        },
        "naziv": {
          "type": "string",
          "minLength": 1
        },
        "podrucje": {
          "enum": [
            "UPRAVLJANJE",
            "IZVORI",
            "IZLAZ",
            "PRIVATNOST",
            "REGULATORNO"
          ]
        },
        "snaga": {
          "enum": [
            "TVRDI_GATE",
            "OBVEZNO",
            "PREPORUKA",
            "INFORMATIVNO"
          ]
        },
        "primjenjivost": {
          "enum": [
            "IZRAVNO",
            "UVJETNO",
            "BUDUCE",
            "NEPRIMJENJIVO",
            "NEUTVRDENO"
          ]
        },
        "zivotni_ciklus": {
          "enum": [
            "AKTIVNO",
            "RADNI_NACRT",
            "ZASTARJELO"
          ]
        },
        "migracija": {
          "enum": [
            "PREUZETO_BEZ_IZMJENE",
            "KONSOLIDIRANO",
            "IZMIJENJENO_ODLUKOM",
            "ZASTARJELO",
            "PROTURJECJE_OTVORENO",
            "IZVAN_OPSEGA"
          ]
        },
        "kanonski_izvori": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/referenca"
          }
        },
        "uvjet_aktiviranja": {
          "type": "string",
          "minLength": 1
        },
        "zahtijeva_ljudsku_odluku": {
          "type": "boolean"
        },
        "provedba": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "testovi": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ci_koraci": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "razina_dokaza": {
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3",
            "D4",
            "D5"
          ]
        },
        "ocjena": {
          "enum": [
            "SUKLADNO",
            "DJELOMICNO",
            "NESUKLADNO",
            "NEDOVOLJNO_DOKAZA",
            "NIJE_PRIMJENJIVO"
          ]
        },
        "otvorene_praznine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
